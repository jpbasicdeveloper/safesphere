import openai
import os
import json

openai.api_key = os.getenv("APICHAT")

def summarize_alert(alert):
    prompt = f"""
You are a weather risk assistant.

Given the following weather alert data, do three things:
1. Summarize the alert in simple language.
2. Explain how severe it is and how confident the forecast is.
3. Give clear, practical advice on what people should do.

Weather Alert Data (JSON):
{json.dumps(alert, indent=2)}

Return the response in this JSON format:
{{
  "summary": "...",
  "severity_explanation": "...",
  "confidence": "...",
  "recommended_actions": "..."
}}
"""

    response = openai.ChatCompletion.create(
        model="gpt-4o-mini",
        messages=[{"role": "user", "content": prompt}],
        temperature=0.3
    )

    return response.choices[0].message.content
